{
  "version": 3,

  "configurePresets": [
    {
      "name": "debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ML_ENABLE_SANITIZERS": "OFF",
        "ML_ENABLE_CLANG_TIDY": "OFF",
        "ML_ENABLE_COVERAGE": "OFF"
      }
    },

    {
      "name": "asan",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ML_ENABLE_SANITIZERS": "ON",
        "ML_ENABLE_CLANG_TIDY": "OFF",
        "ML_ENABLE_COVERAGE": "OFF"
      }
    },

    {
      "name": "tidy",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ML_ENABLE_SANITIZERS": "OFF",
        "ML_ENABLE_CLANG_TIDY": "ON",
        "ML_ENABLE_COVERAGE": "OFF"
      }
    },

    {
      "name": "coverage",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ML_ENABLE_SANITIZERS": "OFF",
        "ML_ENABLE_CLANG_TIDY": "OFF",
        "ML_ENABLE_COVERAGE": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ]
}